{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belle-local-dashboard",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "redact_query_string": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "API_ORIGIN": "https://replace-with-production-api.invalid"
  },
  "env": {
    "staging": {
      "name": "belle-local-dashboard-staging",
      "workers_dev": true,
      "vars": {
        "API_ORIGIN": "https://replace-with-staging-api.invalid"
      }
    }
  }
}
