{
  "name": "belle-local-onlineshopping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "node ../scripts/dashboard-preview.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:main-local": "vite --host 127.0.0.1",
    "build:hosting": "node scripts/build-hosting.mjs",
    "cloudflare:check": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/check",
    "cloudflare:deploy": "npm run build:hosting && wrangler deploy --env=\"\"",
    "cloudflare:deploy:staging": "npm run build:hosting && wrangler deploy --env staging",
    "test:hosting": "node --test cloudflare/worker.test.js ../tests/imported-media-url.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
