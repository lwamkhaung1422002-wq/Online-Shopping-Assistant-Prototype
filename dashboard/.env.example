# Copy to .env.local and use the shop ID from the POS local development DB.
VITE_PUBLIC_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3108
# Replace with the verified shop ID in PostgreSQL; Firebase IDs may differ.
VITE_SHOP_ID=REPLACE_WITH_POS_SHOP_ID
VITE_TURNSTILE_SITE_KEY=
# Hosting: set VITE_SHOP_ID explicitly in the build environment and use
# npm run build:hosting. Set API_ORIGIN and API_PROXY_SECRET on the Worker,
# never as VITE_ secrets. VITE_API_PROXY_TARGET is for local dev only.
